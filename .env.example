# --- Database ---
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- NextAuth ---
NEXTAUTH_SECRET=change-this-to-a-random-string
NEXTAUTH_URL=http://localhost:3050
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- App URL (used for Stripe redirect URLs) ---
NEXT_PUBLIC_APP_URL=http://localhost:3050

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_STUDIO=price_xxx

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Gemini Voices (TTS) ---
# Stored in DB integration_settings as `gemini_api_key`. This env var
# is only used as a fallback for local dev.
GEMINI_API_KEY=

# --- GoHighLevel CRM ---
# Stored in DB integration_settings as `gohighlevel_api_key` /
# `gohighlevel_location_id`. These env vars are not required at runtime.
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=
